{
  "name": "seu-barriga-playwright",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "test:stg": "ENV=Stg playwright test",
    "test:prd": "ENV=Prd playwright test",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:allure": "npm run allure:clean; playwright test; allure generate allure-results --clean -o allure-report",
    "test:unit": "playwright test --project=unit",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit",
    "test:all": "npm run typecheck && npm run test:allure",
    "allure:clean": "rm -rf allure-results allure-report",
    "test:e2e": "playwright test --project=e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.10",
    "typescript": "^5.9.3"
  }
}
