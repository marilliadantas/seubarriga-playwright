{
  "name": "seu-barriga-playwright",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "test:stg": "ENV=Stg playwright test",
    "test:prd": "ENV=Prd playwright test",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:allure": "npm run allure:clean; jest; playwright test; allure generate allure-results --clean -o allure-report",
    "test:jest": "jest",
    "test:unit": "jest tests/unit",
    "test:api": "jest tests/api",
    "typecheck": "tsc --noEmit",
    "test:all": "npm run typecheck && npm run test:jest && npm run test:allure",
    "allure:clean": "rm -rf allure-results allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-jest": "^3.14.0",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.10",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
